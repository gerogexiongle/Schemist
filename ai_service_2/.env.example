# =============================================================================
# Schemist · ai_service_2 — copy to `.env` and adjust (never commit `.env`).
# sql_ai 副本见 sql_ai/ai_service_2/.env.example（**键名一致**）。
#
# 路径默认（不设 SCHEMA_BASE_DIRS 时）：
#   repo 根 = Schemist 目录 → `<repo>/hivebrain` 与 `<repo>/table_filter_schemas`
# 覆盖：SCHEMA_BASE_DIRS 或 SCHEMIST_WORKSPACE_DIR / SQL_AI_WORKSPACE_DIR。
# 配置读取：`app.py` load_dotenv → `config/settings.py`。
# =============================================================================

# -----------------------------------------------------------------------------
# LLM (OpenAI-compatible Chat Completions; required)
# -----------------------------------------------------------------------------
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=

LLM_MODEL=gpt-4o-mini

# Optional: dropdown models JSON, e.g. gateway route ids:
# LLM_MODEL_CHOICES_JSON=[["gpt-4o-mini","GPT-4o mini"],["gpt-4o","GPT-4o"]]

# -----------------------------------------------------------------------------
# Local schema KB (`<database>/json/*.json`); multiple paths `;`-separated
# -----------------------------------------------------------------------------
# SCHEMA_BASE_DIRS=

# -----------------------------------------------------------------------------
# Writable workspace root (temp_sql_v2); alias: SQL_AI_WORKSPACE_DIR
# -----------------------------------------------------------------------------
# SCHEMIST_WORKSPACE_DIR=

# -----------------------------------------------------------------------------
# Trino
# -----------------------------------------------------------------------------
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=schemist
TRINO_PASSWORD=
TRINO_CATALOG=hive
TRINO_SCHEMA=default

# -----------------------------------------------------------------------------
# Spark / SQL execution
# -----------------------------------------------------------------------------
SPARK_QUEUE=default
# SPARK_DYNAMIC_ALLOCATION_ENABLED=true
# SPARK_DYNAMIC_ALLOCATION_MAX_EXECUTORS=80
# SPARK_EXTRA_CONFS=spark.speculation=true
# SPARK_SQL_SET_OVERRIDES=spark.sql.shuffle.partitions=600
# SQL_EXECUTOR_TIMEOUT=900

# -----------------------------------------------------------------------------
# Public base URL (share / Feishu); alias: SQL_AI_PUBLIC_BASE_URL
# -----------------------------------------------------------------------------
# SERVICE_PUBLIC_ORIGIN=http://127.0.0.1:8889

# -----------------------------------------------------------------------------
# Feishu (optional)
# -----------------------------------------------------------------------------
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=
FEISHU_DOC_FOLDER_TOKEN=
FEISHU_DOC_BASE_URL=https://www.feishu.cn

# -----------------------------------------------------------------------------
# Optional: query limits & Skills Pack admin
# -----------------------------------------------------------------------------
# QUERY_RESULT_MAX_ROWS=2000
# SKILLS_ADMIN_TOKEN=
# PIPELINE_TRACE_UI=1
# PIPELINE_TRACE_LOG=1
# PIPELINE_TRACE_UI_TTL_SEC=3600
# SCHEMA_FEEDBACK_PATH=

# -----------------------------------------------------------------------------
# Feishu bot / card tuning (optional)
# -----------------------------------------------------------------------------
# FEISHU_REPLY_MAX_CHARS=18000
# FEISHU_CARD_MD_CHUNK=3800
# FEISHU_CARD_SCHEMA=2
# FEISHU_REPLY_INTERACTIVE=1
# FEISHU_APP_MAPPINGS=
# FEISHU_BOT_DEFAULT_PIPELINE=full
# FEISHU_AUTO_SKILL_MATCH=1
# FEISHU_AUTO_SKILL_EXCLUDE_IDS=data-insights
# FEISHU_AUTO_SKILL_MIN_SCORE=65
# FEISHU_AUTO_SKILL_MARGIN=12
