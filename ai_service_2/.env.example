# =============================================================================
# Schemist · ai_service_2 — 模板文件（可安全提交 Git）
#
# 使用：复制为同目录下的 `.env` 再填写真实值；`.env` 已被 .gitignore 排除。
# 约束：本文件只写占位符（xxx、changeme、localhost 等），勿提交真实
#       API Key、密码、证书、生产域名或内网地址，以免误复制进仓库历史。
# 路径默认相对仓库：<repo>/hivebrain 、<repo>/ai_service_2/
# =============================================================================

# --- LLM (OpenAI-compatible Chat Completions) ---
# Full URL ending with .../chat/completions or base; see agents/base_agent.py
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=

# Must match an id listed in LLM_MODEL_CHOICES_JSON or built-in defaults
LLM_MODEL=gpt-4o-mini

# Optional: override dropdown, e.g. [["moonshotai/kimi-k2.5","Kimi K2.5"],["gpt-4o","GPT-4o"]]
# LLM_MODEL_CHOICES_JSON=

# --- Local schema KB ( dirs must contain `<database>/json/*.json` ) ---
# Multiple paths separated by `;`. Default already points to ../hivebrain
# SCHEMA_BASE_DIRS=

# --- Writable workspace (defaults to ai_service_2/) ---
# SCHEMIST_WORKSPACE_DIR=

# --- Trino ---
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=schemist
TRINO_PASSWORD=
TRINO_CATALOG=hive
TRINO_SCHEMA=default

# --- Spark ---
SPARK_QUEUE=default

# --- Service public URL (Feishu / share links) ---
# SERVICE_PUBLIC_ORIGIN=http://localhost:8889

# --- Feishu (optional): export markdown to doc / bot ---
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=
FEISHU_DOC_FOLDER_TOKEN=
FEISHU_DOC_BASE_URL=https://www.feishu.cn
